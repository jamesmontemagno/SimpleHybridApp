<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="SimpleApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:SimpleApp"
    xmlns:pages="clr-namespace:SimpleApp.Pages"
    Title="SimpleApp"
    FlyoutBehavior="Disabled">

    <TabBar>
        <ShellContent
            Title="Calculator"
            Icon="tab_calculator.png"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage" />

        <ShellContent
            Title="History"
            Icon="tab_history.png"
            ContentTemplate="{DataTemplate pages:HistoryPage}"
            Route="HistoryPage" />

        <ShellContent
            Title="Math Buddy"
            Icon="tab_math_buddy.png"
            ContentTemplate="{DataTemplate pages:MathBuddyPage}"
            Route="MathBuddyPage" />

        <ShellContent
            Title="Settings"
            Icon="tab_settings.png"
            ContentTemplate="{DataTemplate pages:MathBuddySettingsPage}"
            Route="MathBuddySettingsPage" />
    </TabBar>

</Shell>
