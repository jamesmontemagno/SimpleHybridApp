<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:SimpleApp"
             xmlns:converters="clr-namespace:SimpleApp.Converters"
             x:Class="SimpleApp.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:BoolToLayoutOptionsConverter x:Key="BoolToLayoutOptionsConverter" />
            <converters:BoolToBubbleBrushConverter x:Key="BoolToBubbleBrushConverter" />
            <converters:BoolToBubbleTextConverter x:Key="BoolToBubbleTextConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
